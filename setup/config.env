# =============================================================================
# 실세계 RL 스택 설정 — 설치 전에 이 파일만 고치면 된다.
#
# 주의: 네트워크 값은 펌웨어(firmware/src/sac3.cpp)에 하드코딩돼 있다.
#       여기만 바꾸면 안 되고 펌웨어도 같이 고쳐서 다시 플래시해야 한다.
#       어긋나면 에러 없이 조용히 연결되지 않는다.
# =============================================================================

# --- 네트워크 (sac3.cpp의 local_ip / agent_ip / gateway / subnet과 일치) ---
TEENSY_IP=192.168.1.10          # Teensy 4.1 자신의 IP
PC_IP=192.168.1.12              # 에이전트가 도는 PC. PC NIC에 직접 설정할 값
GATEWAY=192.168.1.1
NETMASK=255.255.255.0
AGENT_PORT=8888                 # micro-ROS 에이전트 UDP4 포트

# --- ROS ---
ROS_DOMAIN=121                  # sac3.cpp와 run_dual_sac.sh 양쪽에 박혀 있음
ROS_DISTRO_NAME=jazzy

# --- 경로 ---
WORKSPACE="${WORKSPACE:-$HOME/ros2_ws}"       # 에이전트와 트레이너 공용 워크스페이스
LIBTORCH_DIR="${LIBTORCH_DIR:-$HOME/libtorch}"   # 여기를 바꾸면 트레이너 빌드에 -DCMAKE_PREFIX_PATH로 전달된다
VENV_DIR="${VENV_DIR:-$HOME/rsrl}"           # 학습 실행용 venv (빌드용이 아님)

# --- 버전 ---
# cxx11-ABI여야 ROS 2와 링크된다. pre-cxx11을 받으면 링크 단계에서 ABI 에러.
LIBTORCH_VERSION=2.4.0
